{
  "name": "tacap",
  "version": "1.0.0",
  "description": "Aplicativo para registro de desempenho em avaliação física de capoeira",
  "main": "electron_out/main.js",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev:tsc": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://localhost:5173 electron_out/main.js && electron electron_out/main.js",
    "dev": "npx concurrently \"npm run dev:vite\" \"npm run dev:tsc\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "build:electron": "npx tsc -p tsconfig.node.json && npx electron-builder --publish=never",
    "build": "npm run build:vite && npm run build:electron",
    "start": "dist_electron\\\"TACAP Setup 1.0.0.exe\""
  },
  "private": true,
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.seuapp.tacap",
    "productName": "TACAP",
    "directories": {
      "output": "dist_electron"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "electron_out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/capoeirista.png",
      "forceCodeSigning": false
    }
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sqlite3": "^3.1.11",
    "@types/styled-components": "^5.1.34",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^24.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-svgr": "^4.5.0",
    "wait-on": "^9.0.0",
    "@electron/rebuild": "^4.0.1"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-react": "^5.0.3",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.64.0",
    "styled-components": "^6.1.19",
    "chart.js": "^4.4.3",
    "react-chartjs-2": "^5.2.0",
    "@faker-js/faker": "^10.1.0"
  }
}